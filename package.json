{
  "name": "rolesignal-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": ".venv/bin/python -m uvicorn api.main:app --reload --port 8000 --env-file .env.local",
    "build": "next build",
    "vercel-build": "python -m pip install --disable-pip-version-check --quiet -r requirements.txt && python -m scripts.migrate_deployment && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.5",
    "typescript": "7.0.2"
  }
}
